{
  "1":  { "class_type": "CheckpointLoaderSimple", "_meta": { "title": "Load Checkpoint" },
          "inputs": { "ckpt_name": "DreamShaper_8_pruned.safetensors" } },

  "38": { "class_type": "LoraLoader", "_meta": { "title": "Load LoRA" },
          "inputs": { "lora_name": "pytorch_lora_weights.safetensors",
                      "strength_model": 1.0, "strength_clip": 1.0,
                      "model": ["1", 0], "clip": ["1", 1] } },

  "2":  { "class_type": "CLIPTextEncode", "_meta": { "title": "AI_PROMPT" },
          "inputs": { "text": "", "clip": ["38", 1] } },

  "3":  { "class_type": "CLIPTextEncode", "_meta": { "title": "AI_NEGATIVE" },
          "inputs": { "text": "", "clip": ["38", 1] } },

  "16": { "class_type": "LoadImageFromBase64", "_meta": { "title": "AI_REFERENCE" },
          "inputs": { "data": "" } },

  "40": { "class_type": "ImageScale", "_meta": { "title": "Upscale Image" },
          "inputs": { "upscale_method": "nearest-exact", "width": 512, "height": 512,
                      "crop": "disabled", "image": ["16", 0] } },

  "10": { "class_type": "VAEEncode", "_meta": { "title": "VAE Encode" },
          "inputs": { "pixels": ["40", 0], "vae": ["1", 2] } },

  "21": { "class_type": "AIO_Preprocessor", "_meta": { "title": "AIO Aux Preprocessor" },
          "inputs": { "preprocessor": "none", "resolution": 512, "image": ["40", 0] } },

  "32": { "class_type": "LineArtPreprocessor", "_meta": { "title": "Realistic Lineart" },
          "inputs": { "coarse": "disable", "resolution": 512, "image": ["21", 0] } },

  "26": { "class_type": "ControlNetLoader", "_meta": { "title": "Load ControlNet Model" },
          "inputs": { "control_net_name": "control_v11p_sd15_scribble.pth" } },

  "25": { "class_type": "ControlNetApply", "_meta": { "title": "AI_CONTROL" },
          "inputs": { "strength": 1.0, "conditioning": ["2", 0],
                      "control_net": ["26", 0], "image": ["32", 0] } },

  "31": { "class_type": "KSampler", "_meta": { "title": "AI_SAMPLER" },
          "inputs": { "seed": 0, "steps": 4, "cfg": 1.0,
                      "sampler_name": "lcm", "scheduler": "karras", "denoise": 0.7,
                      "model": ["38", 0], "positive": ["25", 0], "negative": ["3", 0],
                      "latent_image": ["10", 0] } },

  "4":  { "class_type": "VAEDecode", "_meta": { "title": "VAE Decode" },
          "inputs": { "samples": ["31", 0], "vae": ["1", 2] } },

  "5":  { "class_type": "PreviewImage", "_meta": { "title": "AI_OUTPUT" },
          "inputs": { "images": ["4", 0] } }
}
